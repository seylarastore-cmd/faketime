<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Hint for the LSPosed manager. Scoping "System Framework" (android) makes
      handleLoadPackage fire for every app process, which is what enables
      whole-device fake time. The runtime SAFETY_EXCLUDE list in Config still
      skips system_server / SystemUI / our own app.
    -->
    <array name="xposed_scope">
        <item>android</item>
    </array>
</resources>
